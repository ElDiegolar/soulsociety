---
/**
 * Base layout: every SEO primitive lives here so pages only supply title/description/structured data.
 * Zero client-side JavaScript. Styles are inlined at build (see astro.config).
 */
interface Props {
  title: string;
  description: string;
  /** Path for canonical/OG, e.g. "/how-it-works". Defaults to the current URL path. */
  path?: string;
  /** Extra JSON-LD objects for this page (Organization + WebSite are added on every page). */
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
}

const { title, description, path, jsonLd = [], ogType = 'website' } = Astro.props;
const site = Astro.site ?? new URL('https://soulsociety.dev');
const pagePath = path ?? Astro.url.pathname;
const canonical = new URL(pagePath === '/' ? '/' : pagePath.replace(/\/$/, ''), site).toString();
const ogImage = new URL('/og.svg', site).toString();
const fullTitle = pagePath === '/' ? `${title} · soulsociety` : `${title} · soulsociety`;

const baseLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'soulsociety',
    url: site.toString(),
    logo: new URL('/favicon.svg', site).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'soulsociety',
    url: site.toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'soulsociety',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS, Windows (WSL)',
    description:
      'Zero-knowledge hosting and sync for AI companion souls: an encrypted, append-only record of a person that any MCP harness can read and learn into, under the trust the soul itself records.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    license: 'https://opensource.org/licenses/MIT',
  },
];

const nav = [
  { href: '/in-plain-words', label: 'Start here' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/features', label: 'Everything it does' },
  { href: '/security', label: 'Security' },
  { href: '/docs', label: 'Set it up' },
  { href: '/faq', label: 'FAQ' },
  { href: '/glossary', label: 'Glossary' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0b0d17" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3e9d2" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="soulsociety" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="soulsociety: the MCP cycle diagram" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {[...baseLd, ...jsonLd].map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}

    <style is:global>
      :root {
        /* parchment (light) */
        --bg: #f3e9d2;
        --bg-deep: #e9dcc0;
        --fg: #2a2117;
        --muted: #6b5a44;
        --line: #c9b58a;
        --accent: #8a6516;
        --accent-2: #3d6b63;
        --accent-ink: #fff8e6;
        --card: #fbf4e3;
        --code: #ede1c6;
        --glow: rgba(138, 101, 22, 0.18);
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        --sans: 'Crimson Pro', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
        --display: 'Cinzel', 'Trajan Pro', Georgia, serif;
        color-scheme: light dark;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          /* midnight (dark) */
          --bg: #0b0d17;
          --bg-deep: #070810;
          --fg: #ece4d2;
          --muted: #a89f8a;
          --line: #3a3351;
          --accent: #d4af5a;
          --accent-2: #7fd6c6;
          --accent-ink: #15110a;
          --card: #141729;
          --code: #10131f;
          --glow: rgba(212, 175, 90, 0.16);
        }
      }
      * { box-sizing: border-box; }
      html {
        font-family: var(--sans);
        font-size: 118%;
        line-height: 1.62;
        color: var(--fg);
        background: var(--bg);
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        background:
          radial-gradient(1200px 600px at 50% -10%, var(--glow), transparent 60%),
          radial-gradient(1px 1px at 12% 18%, rgba(255, 255, 255, 0.35) 50%, transparent 51%),
          radial-gradient(1px 1px at 70% 9%, rgba(255, 255, 255, 0.28) 50%, transparent 51%),
          radial-gradient(1.5px 1.5px at 86% 32%, rgba(255, 255, 255, 0.3) 50%, transparent 51%),
          radial-gradient(1px 1px at 30% 44%, rgba(255, 255, 255, 0.22) 50%, transparent 51%),
          radial-gradient(1px 1px at 55% 70%, rgba(255, 255, 255, 0.2) 50%, transparent 51%),
          linear-gradient(180deg, var(--bg) 0%, var(--bg-deep) 100%);
        background-attachment: fixed;
      }
      @media (prefers-color-scheme: light) {
        body { background: radial-gradient(1200px 600px at 50% -10%, var(--glow), transparent 60%), linear-gradient(180deg, var(--bg) 0%, var(--bg-deep) 100%); background-attachment: fixed; }
      }
      a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 3px; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      .wrap { max-width: 68rem; margin: 0 auto; padding: 0 1rem; }
      header.site { border-bottom: 1px solid var(--line); background: linear-gradient(180deg, rgba(0,0,0,0.08), transparent); }
      header.site .wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; flex-wrap: wrap; }
      .brand { font-family: var(--display); font-weight: 700; letter-spacing: 0.08em; text-transform: lowercase; text-decoration: none; color: var(--fg); font-size: 1.25rem; display: inline-flex; align-items: center; gap: 0.5rem; }
      .brand b { color: var(--accent); font-weight: 700; }
      .brand::before { content: ''; width: 1.1em; height: 1.1em; border-radius: 50%; border: 2px solid var(--accent); box-shadow: inset 0 0 0 3px var(--bg), inset 0 0 0 4.5px var(--accent); }
      nav.primary ul { display: flex; gap: 1.1rem; list-style: none; padding: 0; margin: 0; flex-wrap: wrap; }
      nav.primary a { color: var(--fg); text-decoration: none; font-size: 0.95rem; letter-spacing: 0.02em; }
      nav.primary a:hover, nav.primary a[aria-current='page'] { color: var(--accent); text-decoration: underline; }
      main { padding: 3.5rem 0 4rem; }
      h1, h2, h3 { font-family: var(--display); letter-spacing: 0.02em; font-weight: 700; }
      h1 { font-size: clamp(1.6rem, 3.2vw, 2.3rem); line-height: 1.25; margin: 0 0 1.1rem; }
      h2 { font-size: 1.45rem; margin: 2.75rem 0 0.9rem; display: flex; align-items: center; gap: 0.6rem; }
      h2::before { content: '✦'; color: var(--accent); font-size: 0.8em; }
      h2::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--line), transparent); }
      h3 { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; }
      p.lead { font-size: 1.2rem; color: var(--muted); max-width: 46rem; margin: 0 0 1.5rem; }
      .cta { display: inline-block; background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 85%, white), var(--accent)); color: var(--accent-ink); padding: 0.7rem 1.2rem; border-radius: 0.4rem; text-decoration: none; font-weight: 700; font-family: var(--display); letter-spacing: 0.04em; font-size: 0.9rem; border: 1px solid color-mix(in srgb, var(--accent) 60%, black); box-shadow: 0 0 0 1px var(--bg), 0 0 0 2px var(--line), 0 8px 24px -12px var(--accent); }
      .cta.secondary { background: transparent; color: var(--accent); box-shadow: none; }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 0.5rem; padding: 1.15rem 1.25rem; position: relative; box-shadow: inset 0 0 0 1px var(--bg), inset 0 0 0 2px color-mix(in srgb, var(--line) 60%, transparent); }
      .card::before, .card::after { content: '✦'; position: absolute; color: var(--accent); font-size: 0.7rem; opacity: 0.8; }
      .card::before { top: 0.35rem; left: 0.5rem; }
      .card::after { bottom: 0.35rem; right: 0.5rem; }
      .card h3 { margin-top: 0; }
      .step { display: grid; grid-template-columns: 2.6rem 1fr; gap: 0.85rem; align-items: start; margin: 1.5rem 0; }
      .step > div { min-width: 0; }
      .step .n { width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; font-weight: 700; font-family: var(--display); box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px var(--accent), 0 0 18px var(--glow); }
      pre, code { font-family: var(--mono); font-size: 0.86em; }
      pre { background: var(--code); border: 1px solid var(--line); border-radius: 0.4rem; padding: 0.95rem 1.05rem; overflow-x: auto; }
      code:not(pre code) { background: var(--code); padding: 0.1em 0.35em; border-radius: 0.3em; }
      table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: 0.97rem; }
      .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
      th, td { text-align: left; border-bottom: 1px solid var(--line); padding: 0.55rem 0.65rem; vertical-align: top; }
      th { color: var(--muted); font-weight: 600; font-family: var(--display); font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; }
      figure { margin: 2rem 0; padding: 1rem; border: 1px solid var(--line); border-radius: 0.6rem; background: color-mix(in srgb, var(--card) 70%, transparent); box-shadow: inset 0 0 60px var(--glow); }
      figure svg { width: 100%; height: auto; display: block; }
      figcaption { color: var(--muted); font-size: 0.95rem; margin-top: 0.6rem; font-style: italic; }
      footer.site { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.92rem; padding: 1.5rem 0 2.5rem; }
      footer.site ul { list-style: none; padding: 0; margin: 0.5rem 0 0; display: flex; gap: 1rem; flex-wrap: wrap; }
      .muted { color: var(--muted); }
      details { border: 1px solid var(--line); border-radius: 0.5rem; padding: 0.65rem 0.95rem; margin: 0.65rem 0; background: var(--card); }
      summary { cursor: pointer; font-weight: 700; font-family: var(--display); font-size: 0.95rem; letter-spacing: 0.02em; }
      dl dt { font-family: var(--display); color: var(--accent); }
      .hero { position: relative; margin: -3.5rem -1rem 1rem; padding: 4.5rem 1rem 3rem; overflow: hidden; border-bottom: 1px solid var(--line); }
      .hero-inner { position: relative; z-index: 1; max-width: 68rem; margin: 0 auto; }
      .shimmer { background: linear-gradient(100deg, var(--fg) 0%, var(--fg) 40%, var(--accent) 50%, var(--fg) 60%, var(--fg) 100%); background-size: 250% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: shimmer 7s ease-in-out infinite; }
      [data-reveal] { opacity: 0; transform: translateY(14px); transition: opacity 0.6s ease, transform 0.6s ease; }
      [data-reveal].in { opacity: 1; transform: none; }
      .card { transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease; }
      .card:hover { transform: translateY(-3px); border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--bg), inset 0 0 0 2px color-mix(in srgb, var(--line) 60%, transparent), 0 14px 30px -18px var(--accent); }
      .cta { transition: transform 0.15s ease, box-shadow 0.25s ease; }
      .cta:hover { transform: translateY(-2px); box-shadow: 0 0 0 1px var(--bg), 0 0 0 2px var(--accent), 0 12px 28px -12px var(--accent); }
      @keyframes shimmer { 0%, 100% { background-position: 100% 0; } 50% { background-position: 0 0; } }
      @media (prefers-reduced-motion: reduce) {
        .shimmer { animation: none; color: var(--fg); background: none; }
        [data-reveal] { opacity: 1; transform: none; transition: none; }
        .card, .cta { transition: none; }
      }
      .skip { position: absolute; left: -999px; }
      .skip:focus { left: 1rem; top: 1rem; background: var(--card); padding: 0.5rem; z-index: 10; }
      @media (max-width: 640px) {
        table.stack, table.stack tbody, table.stack tr, table.stack td { display: block; width: 100%; }
        table.stack thead { display: none; }
        table.stack tr { border: 1px solid var(--line); border-radius: 0.5rem; padding: 0.6rem 0.8rem; margin: 0.75rem 0; background: var(--card); }
        table.stack td { border: 0; padding: 0.25rem 0; }
        table.stack td::before { content: attr(data-label); display: block; font-size: 0.78rem; color: var(--muted); font-family: var(--display); letter-spacing: 0.05em; text-transform: uppercase; }
        table.stack td:first-child::before { display: none; }
        pre { font-size: 0.78rem; }
        nav.primary a { font-size: 1rem; padding: 0.25rem 0; display: inline-block; }
        h2::after { display: none; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/" aria-label="soulsociety home">soul<b>society</b></a>
        <nav class="primary" aria-label="Primary">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={pagePath.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
            <li><a href="https://github.com/ElDiegolar/soulsociety" rel="noopener">GitHub</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <div>soulsociety · zero-knowledge souls for AI harnesses · MIT licensed</div>
        <ul>
          <li><a href="/in-plain-words">Start here</a></li>
          <li><a href="/how-it-works">How it works</a></li>
          <li><a href="/features">Everything it does</a></li>
          <li><a href="/security">Security</a></li>
          <li><a href="/docs">Set it up</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/glossary">Glossary</a></li>
        </ul>
      </div>
    </footer>
    <script>
      // scroll-reveal: pure enhancement; content is visible without it (and under reduced motion)
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll<HTMLElement>('main .card, main h2, main .step, main .demo-panel, main details, main dt');
      if (!reduce && 'IntersectionObserver' in window) {
        els.forEach((el, i) => { el.setAttribute('data-reveal', ''); el.style.transitionDelay = `${(i % 6) * 60}ms`; });
        const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
