---
/** Drifting starfield canvas behind the hero. Decorative only; skipped under reduced motion. */
---

<canvas class="starfield" data-starfield aria-hidden="true"></canvas>

<style>
  .starfield { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; opacity: 0; transition: opacity 1.2s ease; }
  .starfield.on { opacity: 1; }
</style>

<script>
  const c = document.querySelector<HTMLCanvasElement>('[data-starfield]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (c && !reduce) {
    const ctx = c.getContext('2d')!;
    const dark = () => window.matchMedia('(prefers-color-scheme: dark)').matches;
    let w = 0, h = 0, dpr = Math.min(2, window.devicePixelRatio || 1);
    type Star = { x: number; y: number; r: number; v: number; p: number; tw: number };
    let stars: Star[] = [];
    let mx = 0, my = 0;
    const resize = () => {
      const rect = c.parentElement!.getBoundingClientRect();
      w = rect.width; h = rect.height;
      c.width = w * dpr; c.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round((w * h) / 9000);
      stars = Array.from({ length: n }, () => ({ x: Math.random() * w, y: Math.random() * h, r: Math.random() * 1.4 + 0.3, v: Math.random() * 0.08 + 0.02, p: Math.random() * Math.PI * 2, tw: Math.random() * 0.02 + 0.005 }));
    };
    let shoot: { x: number; y: number; vx: number; vy: number; life: number } | null = null;
    const frame = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      const gold = dark() ? '212,175,90' : '138,101,22';
      const white = dark() ? '236,228,210' : '60,45,20';
      for (const s of stars) {
        s.y -= s.v; if (s.y < -2) { s.y = h + 2; s.x = Math.random() * w; }
        s.p += s.tw;
        const a = (0.35 + 0.65 * Math.abs(Math.sin(s.p))) * (dark() ? 0.9 : 0.5);
        const px = s.x + mx * s.r * 6, py = s.y + my * s.r * 6;
        ctx.beginPath(); ctx.arc(px, py, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${s.r > 1.2 ? gold : white},${a})`; ctx.fill();
      }
      if (!shoot && Math.random() < 0.004) shoot = { x: Math.random() * w * 0.8, y: Math.random() * h * 0.4, vx: 6 + Math.random() * 4, vy: 2 + Math.random() * 2, life: 1 };
      if (shoot) {
        ctx.strokeStyle = `rgba(${gold},${shoot.life})`; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(shoot.x, shoot.y); ctx.lineTo(shoot.x - shoot.vx * 6, shoot.y - shoot.vy * 6); ctx.stroke();
        shoot.x += shoot.vx; shoot.y += shoot.vy; shoot.life -= 0.02;
        if (shoot.life <= 0 || shoot.x > w || shoot.y > h) shoot = null;
      }
      if (document.visibilityState === 'visible') requestAnimationFrame(frame);
    };
    window.addEventListener('mousemove', (e) => { mx = (e.clientX / window.innerWidth - 0.5) * 2; my = (e.clientY / window.innerHeight - 0.5) * 2; }, { passive: true });
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') requestAnimationFrame(frame); });
    window.addEventListener('resize', resize, { passive: true });
    resize(); c.classList.add('on'); requestAnimationFrame(frame);
  }
</script>
